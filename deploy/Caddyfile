# TLS + reverse proxy for the candy counter.
#
# Caddy obtains and renews the Let's Encrypt certificate automatically as
# long as halloween-counter.jonathanbell.ca resolves to this box and ports
# 80/443 are reachable. It also handles the two streaming transports out of
# the box: WebSocket upgrades (/ws/game) pass through, and SSE responses
# (/api/events, Content-Type: text/event-stream) are flushed immediately.

# Optional: uncomment to get certificate-expiry emails from Let's Encrypt.
# {
#     email you@example.com
# }

halloween-counter.jonathanbell.ca {
    reverse_proxy app:8080
}
