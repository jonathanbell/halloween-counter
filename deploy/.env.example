# Copy to deploy/.env on the server and fill in real values.
# deploy/.env is gitignored - never commit it.
#
# Generate strong values with: openssl rand -hex 24

# Shared by the app and the postgres container
DATABASE_PASSWORD=change-me

# Increment auth (/api/counter) - baked into the admin QR code
ADMIN_TOKEN=change-me

# Settings + token rotation auth (/api/settings, /api/tokens) - baked into
# the settings QR code
SETTINGS_TOKEN=change-me
