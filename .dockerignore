# Keep the build context small and deterministic. Everything the image
# needs is either declared in package.json / pom.xml or produced by a
# build stage, so no build output belongs in the context.

.git
.github
node_modules
target
dist

# Produced by the frontend stage. A local `npm run bundle` copy in the
# context would shadow it (COPY merges, it does not replace).
src/main/resources/static

# Not part of any stage
docs
scripts
server.js
compose.smoke.yml
Makefile
*.md
.vscode
.idea
.settings
.classpath
.project
.DS_Store
