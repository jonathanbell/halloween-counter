{
  "name": "halloween-counter",
  "private": true,
  "version": "0.0.1-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server.js",
    "dev:all": "npm run build && npm run dev:server",
    "build": "tsc -b && vite build",
    "bundle": "npm run build && rm -rf src/main/resources/static && cp -R dist src/main/resources/static",
